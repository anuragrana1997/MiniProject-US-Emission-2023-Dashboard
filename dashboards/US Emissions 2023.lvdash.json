{
  "datasets": [
    {
      "name": "981a1ee1",
      "displayName": "Emission_location_data",
      "queryLines": [
        "SELECT \r\n",
        "    latitude,\r\n",
        "    longitude,\r\n",
        "    `GHG emissions mtons CO2e` AS emissions\r\n",
        "FROM emissions.default.emissions_data_2023;"
      ]
    },
    {
      "name": "e61a7829",
      "displayName": "Emissions_per_capita",
      "queryLines": [
        "SELECT \r\n",
        "    county_state_name,\r\n",
        "    population,\r\n",
        "    CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / NULLIF(CAST(population AS DOUBLE), 0) AS emissions_per_capita\r\n",
        "FROM emissions.default.emissions_data_2023\r\n",
        "ORDER BY emissions_per_capita DESC;"
      ]
    },
    {
      "name": "174a21dd",
      "displayName": "Emissions_per_state",
      "queryLines": [
        "SELECT \r\n",
        "    state_abbr,\r\n",
        "    SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS total_emissions\r\n",
        "FROM emissions.default.emissions_data_2023\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY total_emissions DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "e569a2a5",
      "displayName": "top_10_emission_percentage",
      "queryLines": [
        "WITH top_10_state_emissions AS (\r\n",
        "    SELECT \r\n",
        "        state_abbr,\r\n",
        "        SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS total_emissions\r\n",
        "    FROM emissions.default.emissions_data_2023\r\n",
        "    GROUP BY state_abbr\r\n",
        "    ORDER BY total_emissions DESC\r\n",
        "    LIMIT 10\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "    (SELECT SUM(total_emissions) FROM top_10_state_emissions) AS top_10_state_emissions, \r\n",
        "    ROUND(((SELECT SUM(total_emissions) FROM top_10_state_emissions) \r\n",
        "    / SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE))) * 100, 2) AS top_10_state_emissions_percentage\r\n",
        "FROM emissions.default.emissions_data_2023;"
      ]
    },
    {
      "name": "cf0eabf2",
      "displayName": "top_10_county_emissions",
      "queryLines": [
        "SELECT\r\n",
        "    county_state_name,\r\n",
        "    population,\r\n",
        "    CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS county_emission\r\n",
        "FROM emissions.default.emissions_data_2023\r\n",
        "ORDER BY county_emission DESC\r\n",
        "LIMIT 10;"
      ]
    }
  ],
